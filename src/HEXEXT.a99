* SPDX-License-Identifier: Apache-2.0
* Copyright 2026 Jon Guidry (hexbus)
* Project: https://github.com/hexbus/ti99-console-tester
* TI-99/4 and TI-99/4A Console Tester - Beta 0.7 extension bank.
*
* PURPOSE
*   Supply the interactive menu, keyboard/joystick inspector, VRAM laboratory,
*   VDP and PSG demonstrations, LED guide, and credits that do not fit in the
*   fixed 8 KiB core. This bank is optional: an 8 KiB tester still performs the
*   automatic core tests and reports that the extension is absent.
*
* MEMORY AND TRUST CONTRACT
*   >6000->7FFF  this direct-mapped 8 KiB extension
*   >C000->C0FF  shared and extension-private state in tester U7 SRAM
*   >D000->D537  relocated original MegaDemo raster payload while it runs
*   >F070...     immutable text, VDP, music, and demo assets in fixed core ROM
*   >FE00        sole callable fixed-core ABI entry, version 1.1
*
*   The core checks this bank's marker, version, entry range, ABI requirement,
*   and zero word sum before branching here. The cartridge header exists only
*   as a convenient TI-99/4A menu entry; the physical LOAD switch reaches the
*   same >FFFC core vector and remains the supported entry on a TI-99/4 or a
*   console whose system GROMs cannot build the title screen.
*
* CALLING CONVENTIONS
*   - Byte values occupy the high byte of a TMS9900 register.
*   - BL overwrites R11. Nested callers save it in a named U7 SRAM cell or in a
*     documented register; do not substitute console scratchpad casually.
*   - Set R8 to SVxxx before BL @SVCENT. The service returns directly to the
*     extension because the gateway dispatches with B, preserving R11.
*   - Interactive pages return with 0; FCTN/CTRL chords are observations, not
*     console actions, so QUIT and other firmware meanings are never executed.
*
* Memory-mapped console devices and the fixed-core gateway.
VDPRD   equ  >8800
VDPST   equ  >8802
VDPWD   equ  >8c00
VDPWA   equ  >8c02
VDPDAT  equ  VDPWD
VDPCTL  equ  VDPWA             * TI has separate status-read/register-write ports
SNDOUT  equ  >8400
LEDOUT  equ  >e002
SVCENT  equ  >fe00

* State shared with the fixed core. Keep these addresses synchronized with
* HEXDIAG.A99; the ABI version must change if their meaning changes.
FLAGS   equ  >c020
ROMSUM  equ  >c022
FAILAD  equ  >c02c
FAILXP  equ  >c02e
FAILAC  equ  >c030
LEDSTA  equ  >c032
SYSID   equ  >c034
FAILMS  equ  >c038
VDP1SH  equ  >c03a             * shared VDP R1 shadow
VDPTMP  equ  >c03c
FVRAM   equ  >0008
LVDPBAD equ  >0200
ID994   equ  >0003

* Extension-private U7 SRAM. Several entries are explicit link-save cells;
* this is intentional on a processor with no hardware stack convention.
XWAIT   equ  >c040             * extension-private return/data cells
XDRAW   equ  >c042
XDATA   equ  >c044
XSAVE   equ  >c046
KRAW    equ  >c048
ALOCK   equ  >c04a
JOY1    equ  >c04c
JOY2    equ  >c04e
WFRAME  equ  >c050
WPHASE  equ  >c052
VDPDLY  equ  >c054
POLSAV  equ  >c056
VBSAV   equ  >c058
VDPSTA  equ  >c05a
KPREV   equ  >c05c
KHOLD   equ  >c05e
KGLYP   equ  >c060             * eight-byte generated bold key glyph
LPRESV  equ  >c068             * saved final LED summary during March-B
POLR8   equ  >c06a             * preserve music event delay across input polling
VDPRTN  equ  >c06c             * caller link for nested VDP mode routines
KEYRTN  equ  >c06e             * caller link for live direct-input renderer
KGLRTN  equ  >c070             * caller link for generated bold key glyph
VRADDR  equ  >c072             * current 256-byte screen-preserving block
VRBLKS  equ  >c074             * completed screen-preserving block count
VRSTOP  equ  >c076             * nonzero when operator stopped between blocks
VRCONT  equ  >c078             * nonzero selects repeated full March-B passes
VRPASSC equ  >c07a             * completed full March-B passes
VRPULS  equ  >c07c             * border-progress color index
KBUF    equ  >c080
J1BUF   equ  >c0a0
J2BUF   equ  >c0c0
VDPHCT  equ  >c0e0             * VDP dwell count; input service preserves registers
KCODE   equ  >c0e2             * translated key code while UI helpers run
KCTLRT  equ  >c0e4             * caller link while Control scan reads columns
MUSPTR  equ  >c0e6             * reserved PSG state cell
MUSDUR  equ  >c0e8             * reserved PSG timing cell
WAVRTN  equ  >c0ea             * caller return while exact raster code owns R10
WAFRTN  equ  >c0ec             * WAVFRM adapter return across the >8300 workspace
WFXDONE equ  >c0ee             * nonzero after original bank-18 frame 1024

* Service selectors for the fixed-core gateway at >FE00.
SVTXT   equ  0                 * initialize shared text display
SVPUT   equ  1                 * R0=VRAM address, R1=zero-terminated text
SVHEX   equ  2                 * R0=VRAM address, R1=word
SVVRAM  equ  3                 * destructive 16 KiB VRAM test, R0=0 pass
SVRES   equ  4                 * redraw automatic-results screen
SVMUTE  equ  5                 * mute all PSG channels
SVKEY   equ  6                 * firmware-independent matrix scan -> >8375
SVLEDS  equ  7                 * walk all six LEDs once
SVAW    equ  8                 * R0=VDP write address
SVRUN   equ  9                 * restart the complete automatic diagnostic
SVMAT   equ  10                * direct two-key matrix decoder/renderer

* Read-only VDP/PSG assets live in otherwise-unused fixed-core ROM.  These
* addresses are part of the core ABI just like SVCENT; keeping the tables out
* of the direct-mapped extension leaves room for keyboard and UI diagnostics.
MDPSG   equ  >f100
VSTART  equ  >f070
VDPAUTO equ  >f08c
VDPNEXT equ  >f0a7
VDPN4   equ  >f0c4
VDBREG  equ  >f546
VDBPDT  equ  >f556
SPRITE  equ  >f576
DEMOAT  equ  >f596
DEMOPAT equ  >f5ab
DEMOFR  equ  >f5eb
VDSTX   equ  >f62b
VDRTTL  equ  >f646
VDCOLL  equ  >f660
VDFIFT  equ  >f66b
VDPDONE equ  >f679
MDFXRM  equ  >f876             * U7-relocated MegaDemo payload in fixed ROM
MDFXLN  equ  >0538             * >536-byte payload plus local RT callback stub
MDFXWK  equ  >d000             * private upper half of tester U7 SRAM

* ---------------------------------------------------------------------------
* Cartridge header, validated private entry, and menu dispatcher
* ---------------------------------------------------------------------------

       aorg >6000
       data >aa01,>0100,>0000,XPROGL
       data >0000,>0000,>0000,>0000

XPROGL data >0000,XENTRY
       byte 15
       text 'HEXBUS DIAG 1.0'
       even

* The console menu and physical LOAD switch enter the exact same core vector.
XENTRY blwp @>fffc
       rt

* Private extension marker, version, entry vector and required core ABI.
       data >d1a6,>1606,EXTENT,>0101

* The fixed core leaves its result page visible.  Do not erase it until the
* operator acknowledges it, which makes the automatic results readable.
EXTENT
       bl   @WAIT0

* MENU accepts only 1-8 and R/r. Selection feedback is drawn before dispatch;
* every other translated or chord-derived value is ignored.
MENU   bl   @DRWMNU
MENULP bl   @MENUPR
       mov  r0,@XDATA
       ci   r0,>3100
       jl   MENDSP
       ci   r0,>3900
       jhe  MENDSP
       mov  r0,r1
       ai   r1,>e500            * ASCII 1..8 -> private glyph >16..>1D
       mov  r0,r2
       srl  r2,8
       dec  r2
       sla  r2,6
       ai   r2,>00a2
       mov  r2,r0
       bl   @MENUACK
MENDSP mov  @XDATA,r0
       ci   r0,>3100
       jne  MNCK2
       b    @RESULTS
MNCK2
       ci   r0,>3200
       jne  MNCK3
       b    @KEYTST
MNCK3
       ci   r0,>3300
       jne  MNCK4
       b    @VRAMTS
MNCK4
       ci   r0,>3400
       jne  MNCK5
       b    @VDPSHW
MNCK5
       ci   r0,>3500
       jne  MNCK6
       b    @PSGTST
MNCK6
       ci   r0,>3600
       jne  MNCK7
       b    @VRAMID
MNCK7
       ci   r0,>3700
       jne  MNCK8
       b    @LEDTST
MNCK8  ci   r0,>3800
       jne  MNCKR
       b    @CREDITS
MNCKR  ci   r0,>5200           * R warm-starts the automatic-test core
       jne  MNCKRL
       b    @RERUN
MNCKRL
       ci   r0,>7200
       jne  MNNONE
       b    @RERUN
MNNONE
       jmp  MENULP

* DRWMNU - initialize text mode and paint the complete main menu from ROM.
DRWMNU mov  r11,@XDRAW
       li   r8,SVTXT
       bl   @SVCENT
       li   r0,>0004            * original title centered in the top border
       li   r1,MNTITL
       bl   @PUTS
       li   r0,>0022            * row 1: product and version
       li   r1,MNBIOS
       bl   @PUTS
       li   r0,>0044            * row 2: centered project/date line
       li   r1,MNSUB
       bl   @PUTS
       li   r0,>0065            * row 3: centered public-beta warning
       li   r1,MNWARN
       bl   @PUTS
       li   r0,>00a2
       li   r1,MN1
       bl   @PUTS
       li   r0,>00e2
       li   r1,MN2
       bl   @PUTS
       li   r0,>0122
       li   r1,MN3
       bl   @PUTS
       li   r0,>0162
       li   r1,MN4
       bl   @PUTS
       li   r0,>01a2
       li   r1,MN5
       bl   @PUTS
       li   r0,>01e2
       li   r1,MN6
       bl   @PUTS
       li   r0,>0222
       li   r1,MN7
       bl   @PUTS
       li   r0,>0262
       li   r1,MN8
       bl   @PUTS
       li   r0,>02c4            * final usable row, immediately above border
       li   r1,MNFOOT
       bl   @PUTS
       mov  @XDRAW,r11
       rt

* RESULTS - ask the fixed core to redraw its retained automatic-test results.
RESULTS
       li   r8,SVRES
       bl   @SVCENT
       bl   @WAIT0
       b    @MENU

* ---------------------------------------------------------------------------
* Keyboard and joystick diagnostics
* ---------------------------------------------------------------------------
* The translated code is produced by the fixed-core matrix service; a second
* direct scan exposes every physical position in a two-key chord, including
* Shift, Control, FCTN, AUX-1, and AUX-2. No stock KSCAN routine is used.
*
* A /4A shares the Alpha-Lock/joystick-Up path. ALPHCK actively distinguishes
* the switch from joystick Up before the UI decides whether joystick readings
* are safe. The 1979 /4 uses its own five-column keyboard table and hardware-
* verified joystick selectors 5 and 6.
KEYTST li   r8,SVTXT
       bl   @SVCENT
       li   r0,>0005
       li   r1,KTITL
       bl   @PUTS
       li   r0,>0062
       li   r1,KINST1
       bl   @PUTS
       li   r0,>00a2
       li   r1,KINST2
       bl   @PUTS
       li   r0,>00e2
       li   r1,KPRESS
       bl   @PUTS
       li   r0,>02c6
       li   r1,KBACK
       bl   @PUTS
       li   r0,>ff00
       mov  r0,@KPREV
       clr  @KHOLD
       li   r1,KTMPL
       li   r2,KBUF
       bl   @CPYSTR
       li   r1,J1TMPL
       li   r2,J1BUF
       bl   @CPYSTR
       li   r1,J2TMPL
       li   r2,J2BUF
       bl   @CPYSTR
KEYLOP li   r8,SVKEY
       bl   @SVCENT
       clr  r9
       movb @>8375,r9
       mov  @SYSID,r0
       ci   r0,ID994             * /4 has no lower-case keyboard repertoire
       jeq  KEYRAW
       bl   @KEYNRM              * normalize 4A/QI case and Control codes
KEYRAW
       ci   r9,>3000
       jne  KEYH0
       inc  @KHOLD
       mov  @KHOLD,r0
       ci   r0,60
       jhe  KEYEXIT
       jmp  KEYACK
KEYH0  clr  @KHOLD
KEYACK bl   @KEYBEP
       mov  r9,r1
       srl  r1,8
       li   r0,>00b4
       li   r8,SVHEX
       bl   @SVCENT
       mov  @SYSID,r0
       ci   r0,ID994             * only a confirmed 1979 set suppresses 4A inputs
       jeq  KEY994
       bl   @KEYDIR
       jmp  KEYDLY
KEY994 li   r0,KEYDLY
       mov  r0,@KEYRTN           * this path branches in; provide its return link
       li   r8,SVMAT             * use the authentic five-column /4 table
       bl   @SVCENT
       li   r0,>0162
       li   r1,K994TX
       bl   @PUTS
       b    @KJ994               * inspect every documented /4 selector variant
KEYDLY bl   @VDPVB
       jmp  KEYLOP
KEYEXIT
       clr  r12
       sbo  21
       b    @MENU

* KEYBEP - acknowledge a newly translated key and render its visible name.
* A new translated key gets the same short acknowledgement tone as a menu
* selection. Printable upper/lower-case keys are copied from the active font,
* emboldened into private glyph >1E, and displayed. Enter is named explicitly;
* the numeric line remains authoritative for the other control characters.
KEYBEP mov  r11,r10
       mov  r9,@KCODE
       mov  r9,r0
       ci   r0,>ff00
       jne  KBEPID
       mov  @KRAW,r0            * modifier-only presses have no translated byte
       ci   r0,>1000
       jeq  KBEPID
       ci   r0,>2000
       jeq  KBEPID
       ci   r0,>4000
       jeq  KBEPID
       li   r0,>ff00
KBEPID c    r0,@KPREV
       jeq  KBEPRT
       mov  r0,@KPREV
       ci   r0,>ff00
       jeq  KBEPCL
       bl   @KEYGLY
       li   r0,>8800
       movb r0,@SNDOUT
       li   r0,>0800
       movb r0,@SNDOUT
       li   r0,>9200
       movb r0,@SNDOUT
       li   r5,2
KBEEPL bl   @VDPVB
       dec  r5
       jne  KBEEPL
       bl   @XMUTE
       mov  @KPREV,r9
       jmp  KBEPRT
KBEPCL li   r0,>00f0
       li   r1,KCLR
       bl   @PUTS
KBEPRT mov  @KCODE,r9           * retain the real translated code for display
       b    *r10

KEYGLY mov  r11,@KGLRTN
       li   r0,>00f0
       li   r1,KCLR               * erase a previous ENTER or bold glyph
       bl   @PUTS
       mov  @KCODE,r9             * PUTS may use the caller's key register
       ci   r9,>ff00
       jne  KGLCOD
       mov  @KRAW,r0
       mov  @SYSID,r1
       ci   r1,ID994
       jne  KGLM4A
       ci   r0,>1000             * sole /4 modifier is its orange SHIFT key
       jeq  KGLSHF
KGLM4A
       ci   r0,>2000
       jeq  KGLSHF
       ci   r0,>1000
       jeq  KGLFCT
       ci   r0,>4000
       jeq  KGLCTR
       jmp  KGLDON
KGLCOD mov  @KRAW,r0
       mov  r0,r1
       andi r1,>1000             * /4 SHIFT or /4A FCTN function chord
       jeq  KGLCCK
       li   r2,KDIRTB
       li   r3,4
KGLDLP c    *r2+,r9
       jeq  KGLDFN
       inct r2
       dec  r3
       jne  KGLDLP
       jmp  KGLCCK
KGLDFN mov  *r2,r1
       jmp  KGLTXT
KGLCCK mov  @KRAW,r0
       andi r0,>4000
       jeq  KGLSPC
       ci   r9,>0100
       jl   KGLSPC
       ci   r9,>1b00
       jhe  KGLSPC
       li   r1,KCTEXT             * ROM is immutable: copy before patching A-Z
       li   r2,KBUF
       bl   @CPYSTR
       mov  r9,r0                 * Control A-Z: show a readable chord name
       ai   r0,>4000
       movb r0,@KBUF+5
       li   r0,>00f0
       li   r1,KBUF
       bl   @PUTS
       jmp  KGLDON
KGLSPC ci   r9,>2000
       jne  KGLENT
       li   r1,KSPACE
       jmp  KGLTXT
KGLSHF li   r1,KSHIFT
       jmp  KGLTXT
KGLFCT li   r1,KFCTN
       jmp  KGLTXT
KGLCTR li   r1,KCTRL
KGLTXT li   r0,>00f0
       bl   @PUTS
       jmp  KGLDON
KGLENT
       ci   r9,>0d00
       jne  KGLCHR
       li   r0,>00f0
       li   r1,KENTER
       bl   @PUTS
       mov  @KGLRTN,r11
       rt
KGLCHR
       mov  r9,r0
       ci   r0,>2000
       jl   KGLCTL
       ci   r0,>7f00
       jl   KGLADR
KGLCTL li   r0,>3f00            * '?' visibly denotes a control/FCTN code
KGLADR srl  r0,8
       sla  r0,3
       ai   r0,>0800            * current font pattern table base
       bl   @XSETAR
       li   r4,KGLYP
       li   r5,8
KGLRD  clr  r1
       movb @VDPRD,r1
       nop
       mov  r1,r2
       srl  r2,1
       soc  r2,r1               * thicken each stroke one pixel right
       movb r1,*r4+
       dec  r5
       jne  KGLRD
       li   r0,>08f0            * pattern for private character >1E
       bl   @XSETAW
       li   r4,KGLYP
       li   r5,8
KGLWR  movb *r4+,@VDPWD
       nop
       dec  r5
       jne  KGLWR
       li   r0,>00f0
       li   r1,>1e00
       bl   @VRW1X
KGLDON
       mov  @KGLRTN,r11
       rt

* KEYNRM - normalize the 48-key /4A/QI matrix into one diagnostic code.
* In/out: R9 high byte. Preserves caller link through KEYRTN.
*
* Present one stable ASCII interpretation for the 48-key /4A and QI matrix:
* Control >80->9F becomes >00->1F, and an unmodified A-Z becomes lower case
* only while Alpha Lock is physically released.  A confirmed /4 bypasses this
* routine because its built-in character set is upper-case only.
KEYNRM mov  r11,@KEYRTN
       clr  r1
       bl   @RDCOL
       mov  r4,@KRAW

* Translate every printable FCTN combination marked on the /4A key legends.
* The direct service has already returned the ordinary key in R9, so a compact
* key/value table is both smaller and less error-prone than rescanning columns.
* Direction keys E/S/D/X intentionally remain letters here; KEYGLY names their
* physical FCTN chords UP/LEFT/RIGHT/DOWN without making them menu actions.
       mov  @KRAW,r0
       andi r0,>1000
       jeq  KNCTRL
       li   r1,KFCTAB
       li   r2,12
KNFCLP c    r9,*r1+              * entry is input letter, printable result
       jeq  KNFCND
       inct r1
       dec  r2
       jne  KNFCLP
       jmp  KNCTRL               * unlabelled FCTN chord remains diagnostic data
KNFCND mov  *r1,r9
       jmp  KNRETN
KNCTRL mov  @KRAW,r0
       andi r0,>4000
       jeq  KNBASE
       bl   @KCTL                * synthesize ASCII Control-A through -Z
KNBASE
       mov  r9,r0
       ci   r0,>8000
       jl   KNALPH
       ci   r0,>a000
       jhe  KNALPH
       andi r9,>7f00             * Control A-Z: ASCII >01->1F
KNALPH
       ci   r9,>4100
       jl   KNRETN
       ci   r9,>5b00
       jhe  KNRETN
       mov  @KRAW,r0
       andi r0,>7000             * FCTN, Shift, or Control held?
       jne  KNRETN
       bl   @ALPHCK
       mov  r0,r0
       jne  KNRETN
       ai   r9,>2000             * released Alpha Lock: A-Z -> a-z
KNRETN mov  @KEYRTN,r11
       rt

* TI-99/4A FCTN punctuation printed beneath the letter keys.
KFCTAB data >4100,>7c00          * A = |
       data >4300,>6000          * C = grave accent/backtick
       data >4600,>7b00          * F = {
       data >4700,>7d00          * G = }
       data >4900,>3f00          * I = ?
       data >4f00,>2700          * O = apostrophe
       data >5000,>2200          * P = quotation mark
       data >5200,>5b00          * R = [
       data >5400,>5d00          * T = ]
       data >5500,>5f00          * U = _
       data >5700,>7e00          * W = ~
       data >5a00,>5c00          * Z = reverse solidus/backslash

* KEYDIR - render /4A/QI raw chord, Alpha Lock, and both joystick ports.
* KEYNRM has already sampled column zero and stored it in KRAW.
KEYDIR mov  r11,@KEYRTN
       li   r8,SVMAT             * render every physical key in a two-key chord
       bl   @SVCENT
       li   r1,KTMPL
       li   r2,KBUF
       bl   @CPYSTR
       mov  @KRAW,r4
       li   r2,KBUF+14
       li   r3,>2000            * Shift = CRU input 8 (first STCR bit is row 3)
       bl   @BITCHR
       li   r2,KBUF+19
       li   r3,>4000            * Control = CRU input 9
       bl   @BITCHR
       li   r2,KBUF+24
       li   r3,>1000            * FCTN = CRU input 7
       bl   @BITCHR
       li   r0,>0162
       li   r1,KBUF
       bl   @PUTS
       bl   @ALPHCK
       mov  r0,@ALOCK
       mov  r0,r0
       jeq  KJOYOK
       li   r0,>01a2
       li   r1,ALPDWN
       bl   @PUTS
       li   r0,>01e2
       li   r1,JOYBLK
       bl   @PUTS
       li   r0,>0222
       li   r1,JOYCLR
       bl   @PUTS
       mov  @KEYRTN,r11
       rt
KJOYOK li   r0,>01a2
       li   r1,ALPUP
       bl   @PUTS
KJSCAN
       li   r5,6                 * /4A: joystick 1 selector
       jmp  KJCOM
KJ994  li   r5,5                 * /4: joystick 1 selector (hardware verified)
KJCOM  mov  r5,r1
       bl   @JOYRD
       mov  r0,@JOY1
       li   r2,J1BUF
       bl   @JOYFMT
       li   r0,>01e2
       li   r1,J1BUF
       bl   @PUTS
       inc  r5                   * adjacent selector is joystick 2
       mov  r5,r1
       bl   @JOYRD
       mov  r0,@JOY2
       li   r2,J2BUF
       bl   @JOYFMT
       li   r0,>0222
       li   r1,J2BUF
       bl   @PUTS
       mov  @KEYRTN,r11
       rt

* R1=column 0..7. Output bits are TMS9901 CRU 18..20.
* COLSEL - select TMS9901 keyboard/joystick column R1 (low three bits).
COLSEL mov  r1,r0
       swpb r0
       li   r12,>0024
       ldcr r0,3
       rt

* Select R1=keyboard column, then return its active-high row mask in R4.
* RDCOL - read one selected matrix column.
* In: R1=column. Out: R4=active-high eight-row mask. Clobbers R0/R12.
RDCOL  clr  r12
       sbo  21                   * keep Alpha Lock out of ordinary scans
       mov  r1,r0                * inline COLSEL so R11 still returns to caller
       swpb r0
       li   r12,>0024
       ldcr r0,3
       li   r12,6
       seto r4
       stcr r4,8
       inv  r4
       rt

* With Control held, translate any directly observed alphabetic key into its
* ASCII control value.  Five eight-byte rows correspond to columns 1..5.
* KCTL - synthesize ASCII Control-A through Control-Z from physical columns.
* Out: R9 high byte when a letter chord is found; otherwise leaves R9 intact.
KCTL   mov  r11,@KCTLRT          * RDCOL uses R11 for each nested column read
       li   r9,>ff00             * no translated chord until a letter is found
       li   r1,1
       li   r7,KCTAB
       li   r6,5
KCTCOL bl   @RDCOL
       li   r3,>0100
       li   r2,8
KCTROW czc  r3,r4
       jeq  KCTNXT
       clr  r0
       movb *r7,r0
       jeq  KCTNXT               * punctuation/digit in this matrix position
       mov  r0,r9
       jmp  KCTRET
KCTNXT inc  r7
       sla  r3,1
       dec  r2
       jne  KCTROW
       inc  r1
       dec  r6
       jne  KCTCOL
KCTRET mov  @KCTLRT,r11
       rt

* ALPHCK - distinguish physical Alpha Lock from joystick Up on their shared
* /4A input. Out: R0=1 when Alpha Lock is down, 0 when released. /4A only.
* Alpha Lock and joystick Up both reach INT7. Probe P5 high first and choose
* a keyboard column whose ordinary INT7 key is released, then pull P5 low.
* With the documented two-key scope, at least one column is always available.
ALPHCK clr  r1
ALPTRY mov  r1,r0                * inline COLSEL: ALPHCK must preserve its link
       swpb r0
       li   r12,>0024
       ldcr r0,3
       li   r12,>002a
       sbo  0                    * P5 inactive: sample selected INT7 matrix key
       li   r12,>000e
       tb   0
       jeq  ALPTEST
       inc  r1
       ci   r1,6
       jl   ALPTRY
       clr  r0                   * outside two-key scope: never false-warn
       rt
ALPTEST
       li   r12,>002a
       sbz  0                    * P5 active: only Alpha Lock can add INT7
       li   r12,>000e
       clr  r0
       tb   0
       jeq  ALPHUP
       inc  r0
ALPHUP li   r12,>002a
       sbo  0
       rt

* R1=6 or 7. STCR stores its first CRU bit in the byte LSB, so return the
* active-high F/L/R/D/U inputs in R0 bits >0100,>0200,>0400,>0800,>1000.
* JOYRD - read one joystick selector and format F/L/R/D/U into a text buffer.
* In: R1=selector, R2=destination buffer. Out: raw mask stored at *R7.
JOYRD  mov  r11,@XSAVE
       clr  r12
       sbo  21
       bl   @COLSEL
       li   r12,6
       seto r0
       stcr r0,5
       inv  r0
       andi r0,>1f00
       mov  @XSAVE,r11
       rt

* R4=value, R3=mask, R2=destination byte.
BITCHR li   r1,>3000
       czc  r3,r4
       jeq  BITCH0
       li   r1,>3100
BITCH0 movb r1,*r2
       rt

* R0=joystick bits, R2=RAM line. Flag bytes are at 15,17,19,21,23.
JOYFMT mov  r11,@XSAVE
       mov  r0,r4
       ai   r2,15
       li   r3,>0100
       bl   @BITCHR
       ai   r2,2
       li   r3,>0200
       bl   @BITCHR
       ai   r2,2
       li   r3,>0400
       bl   @BITCHR
       ai   r2,2
       li   r3,>0800
       bl   @BITCHR
       ai   r2,2
       li   r3,>1000
       bl   @BITCHR
       mov  @XSAVE,r11
       rt

* CPYSTR - copy a zero-terminated byte string from ROM to tester SRAM.
CPYSTR movb *r1+,*r2+
       jne  CPYSTR
       rt

* ---------------------------------------------------------------------------
* VRAM laboratory and low-level VRAM access
* ---------------------------------------------------------------------------
* The screen-preserving path repaints the UI before testing each
* 256-byte block; the strict whole-array March-B remains a separate option
* because repainting between March elements would invalidate coupling state.
VRAMTS li   r8,SVTXT
       bl   @SVCENT
       li   r0,>000b
       li   r1,VRLABT
       bl   @PUTS
       li   r0,>0062
       li   r1,VRLAB1
       bl   @PUTS
       li   r0,>00a2
       li   r1,VRLAB2
       bl   @PUTS
       li   r0,>00e2
       li   r1,VRLAB3
       bl   @PUTS
       li   r0,>0122
       li   r1,VRLAB0
       bl   @PUTS
       li   r0,>01a2
       li   r1,VRLABN
       bl   @PUTS
       bl   @MENUPR
       ci   r0,>3100
       jeq  VRSCRB
       ci   r0,>3200
       jne  VRLB3
       clr  @VRCONT
       b    @VRFULL
VRLB3  ci   r0,>3300
       jne  VRLB0
       li   r0,1
       mov  r0,@VRCONT
       b    @VRFULL
VRLB0
       ci   r0,>3000
       jeq  VRLABX
       jmp  VRAMTS
VRLABX b    @MENU

* Tutor-style screen-preserving scrub.  Each 256-byte block receives the same
* 17N local March-B, after which the complete page is rebuilt from ROM.  This
* tests every VRAM byte while retaining visible progress and a safe stop point.
VRSCRB clr  @VRADDR
       clr  @VRBLKS
       clr  @VRSTOP
       clr  @XDATA
       mov  @LEDSTA,r0
       mov  r0,@LPRESV
VRSLOP li   r8,SVTXT
       bl   @SVCENT
       li   r0,>0002
       li   r1,VRSCTT
       bl   @PUTS
       li   r0,>0062
       li   r1,VRSINFO
       bl   @PUTS
       li   r0,>00a2
       li   r1,VSCUR
       bl   @PUTS
       li   r0,>00b3
       mov  @VRADDR,r1
       li   r8,SVHEX
       bl   @SVCENT
       li   r0,>00e2
       li   r1,VSBLK
       bl   @PUTS
       li   r0,>00f5
       mov  @VRBLKS,r1
       li   r8,SVHEX
       bl   @SVCENT
       li   r0,>0122
       li   r1,VSSTOP
       bl   @PUTS
       li   r0,>f607
       bl   @VDPREGW
       mov  @VRADDR,r8
       bl   @VRBLK
       mov  r0,@XDATA
       jne  VRSBAD
       inc  @VRBLKS
       bl   @POLL0
       jeq  VRSNXT
       li   r0,1
       mov  r0,@VRSTOP
       jmp  VRSEND
VRSNXT mov  @VRADDR,r0
       ai   r0,>0100
       mov  r0,@VRADDR
       mov  @VRBLKS,r0
       ci   r0,64
       jl   VRSLOP
       jmp  VRSEND
VRSBAD li   r1,FVRAM
       soc  r1,@FLAGS
       mov  @LEDSTA,r1
       andi r1,>dfff
       ori  r1,LVDPBAD
       mov  r1,@LEDSTA
       movb r1,@LEDOUT
VRSEND mov  @XDATA,r0
       jne  VRSRDR
       mov  @LPRESV,r1
       movb r1,@LEDOUT
VRSRDR li   r8,SVTXT
       bl   @SVCENT
       li   r0,>0004
       li   r1,VRSRTT
       bl   @PUTS
       li   r0,>0082
       li   r1,VSCOV
       bl   @PUTS
       li   r0,>00c2
       li   r1,VSBCT
       bl   @PUTS
       li   r0,>00d3
       mov  @VRBLKS,r1
       li   r8,SVHEX
       bl   @SVCENT
       li   r0,>0148
       li   r1,VPASS
       mov  @XDATA,r2
       jne  VRSFAIL
       mov  @VRSTOP,r2
       jeq  VRSSHOW
       li   r1,VSTOP
       jmp  VRSSHOW
VRSFAIL
       li   r1,VFAIL
VRSSHOW
       bl   @PUTS
       li   r0,>01c2
       li   r1,ZEROMNU
       bl   @PUTS
       bl   @WAIT0
       b    @MENU

* Tutor v1.0 destructive 17N March-B over all 16 KiB.  A newly found fault
* is promoted into the same flag and LED group as the automatic pass.
VRFULL li   r8,SVTXT
       bl   @SVCENT
       li   r0,>0003
       li   r1,VTITL
       bl   @PUTS
       li   r0,>0082
       li   r1,VTWARN
       bl   @PUTS
       li   r0,>00c2
       li   r1,VINFO1
       bl   @PUTS
       li   r0,>0102
       li   r1,VSTART
       bl   @PUTS
       bl   @WAITKY
       ci   r0,>3000
       jne  VRFGO
       b    @MENU
VRFGO
       mov  @LEDSTA,r0
       mov  r0,@LPRESV
       clr  @VRPASSC
       clr  @VRSTOP
VRFAGN clr  @VRPULS
       li   r0,>8081            * display off; border and LEDs show progress
       bl   @VDPREGW
       bl   @VRMARCH
       mov  r0,@XDATA
       ci   r0,2
       jeq  VRPASS
       mov  r0,r0
       jne  VRFAIL
       inc  @VRPASSC
       mov  @VRCONT,r0
       jne  VRFAGN
       jmp  VRPASS
VRFAIL
       li   r1,FVRAM
       soc  r1,@FLAGS
       mov  @LEDSTA,r1
       andi r1,>dfff
       ori  r1,LVDPBAD
       mov  r1,@LEDSTA
       movb r1,@LEDOUT
       jmp  VRTEXT
VRPASS mov  @LPRESV,r1
       movb r1,@LEDOUT
VRTEXT li   r8,SVTXT
       bl   @SVCENT
       li   r0,>0003
       li   r1,VTITL
       bl   @PUTS
       li   r0,>0082
       li   r1,VMARCH
       bl   @PUTS
       li   r0,>00c2
       li   r1,VINFO2
       bl   @PUTS
       li   r0,>0148
       li   r1,VPASS
       mov  @XDATA,r2
       jeq  VRSTAT
       ci   r2,2
       jeq  VRSTOPR
       li   r1,VFAIL
       jmp  VRSTAT
VRSTOPR
       li   r1,VSTOP
VRSTAT mov  r11,@XDRAW
       mov  r1,@XSAVE           * preserve PASS/STOP/FAIL text across hex draw
       li   r0,>0102
       li   r1,VPCNT
       bl   @PUTS
       li   r0,>0115
       mov  @VRPASSC,r1
       li   r8,SVHEX
       bl   @SVCENT
       mov  @XDRAW,r11
       mov  @XSAVE,r1
       li   r0,>0148
VRSHOW bl   @PUTS
       li   r0,>01c2
       li   r1,ZEROMNU
       bl   @PUTS
       bl   @WAIT0
       b    @MENU

* VRMARCH - destructive full-array March-B.
* Out: R0=0 pass, R0=1 operator stop, R0=2 failure. On failure, FAILAD,
* FAILXP, FAILAC, and FAILMS describe the first observed mismatch.
*
* Algorithm:
* {w0; up(r0,w1,r1,w0,r0,w1); up(r1,w0,w1);
*  down(r1,w0,w1,w0); down(r0,w1,w0)} = 17 operations per cell.
VRMARCH mov  r11,r13
       li   r0,>0700            * phase 0: all three confirmed red lamps
       movb r0,@LEDOUT
       li   r0,>f607            * dark-red border
       bl   @VDPREGW
       clr  r4
       li   r5,>4000
       li   r7,>0100
       clr  r1
VRMB0  mov  r4,r0
       bl   @VRW1X
       inc  r4
       dec  r5
       jeq  VRMB0D
       dec  r7
       jne  VRMB0
       bl   @VRMPOL
       mov  @VRSTOP,r0
       jeq  VRMB0C
       b    @VRMAB
VRMB0C
       li   r7,>0100
       jmp  VRMB0
VRMB0D

* M1 ascending: r0,w1,r1,w0,r0,w1.
       li   r0,>0300            * phase 1: two red lamps
       movb r0,@LEDOUT
       li   r0,>f807            * medium-red border
       bl   @VDPREGW
       clr  r4
       li   r5,>4000
       li   r7,>0100
VRMB1  mov  r4,r0
       bl   @VRR1
       mov  r2,r2
       jeq  VRMB1A
       b    @VRMBZ
VRMB1A
       mov  r4,r0
       li   r1,>ff00
       bl   @VRW1X
       mov  r4,r0
       bl   @VRR1
       li   r6,>ff00
       cb   r6,r2
       jeq  VRMB1B
       b    @VRMBAD
VRMB1B
       mov  r4,r0
       clr  r1
       bl   @VRW1X
       mov  r4,r0
       bl   @VRR1
       mov  r2,r2
       jeq  VRMB1C
       b    @VRMBZ
VRMB1C
       mov  r4,r0
       li   r1,>ff00
       bl   @VRW1X
       inc  r4
       dec  r5
       jeq  VRMB1D
       dec  r7
       jne  VRMB1
       bl   @VRMPOL
       mov  @VRSTOP,r0
       jeq  VRMB1E
       b    @VRMAB
VRMB1E
       li   r7,>0100
       jmp  VRMB1
VRMB1D

* M2 ascending: r1,w0,w1.
       li   r0,>0100            * phase 2: one red lamp
       movb r0,@LEDOUT
       li   r0,>fb07            * light-yellow border
       bl   @VDPREGW
       clr  r4
       li   r5,>4000
       li   r7,>0100
VRMB2  mov  r4,r0
       bl   @VRR1
       li   r6,>ff00
       cb   r6,r2
       jne  VRMBAD
       mov  r4,r0
       clr  r1
       bl   @VRW1X
       mov  r4,r0
       li   r1,>ff00
       bl   @VRW1X
       inc  r4
       dec  r5
       jeq  VRMB2D
       dec  r7
       jne  VRMB2
       bl   @VRMPOL
       mov  @VRSTOP,r0
       jne  VRMAB
       li   r7,>0100
       jmp  VRMB2
VRMB2D

* M3 descending: r1,w0,w1,w0.
       li   r0,>1000            * phase 3: first confirmed green lamp
       movb r0,@LEDOUT
       li   r0,>f707            * cyan border
       bl   @VDPREGW
       li   r4,>3fff
       li   r5,>4000
       li   r7,>0100
VRMB3  mov  r4,r0
       bl   @VRR1
       li   r6,>ff00
       cb   r6,r2
       jne  VRMBAD
       mov  r4,r0
       clr  r1
       bl   @VRW1X
       mov  r4,r0
       li   r1,>ff00
       bl   @VRW1X
       mov  r4,r0
       clr  r1
       bl   @VRW1X
       dec  r4
       dec  r5
       jeq  VRMB3D
       dec  r7
       jne  VRMB3
       bl   @VRMPOL
       mov  @VRSTOP,r0
       jne  VRMAB
       li   r7,>0100
       jmp  VRMB3
VRMB3D

* M4 descending: r0,w1,w0.
       li   r0,>3000            * phase 4: both confirmed green lamps
       movb r0,@LEDOUT
       li   r0,>f307            * light-green border
       bl   @VDPREGW
       li   r4,>3fff
       li   r5,>4000
       li   r7,>0100
VRMB4  mov  r4,r0
       bl   @VRR1
       mov  r2,r2
       jne  VRMBZ
       mov  r4,r0
       li   r1,>ff00
       bl   @VRW1X
       mov  r4,r0
       clr  r1
       bl   @VRW1X
       dec  r4
       dec  r5
       jeq  VRMB4D
       dec  r7
       jne  VRMB4
       bl   @VRMPOL
       mov  @VRSTOP,r0
       jne  VRMAB
       li   r7,>0100
       jmp  VRMB4
VRMB4D
       clr  r0
       b    *r13
VRMAB  li   r0,2
       b    *r13
VRMBZ  clr  r6
VRMBAD mov  r4,@FAILAD
       mov  r6,@FAILXP
       mov  r2,@FAILAC
       mov  r6,r1
       xor  r2,r1
       mov  r1,@FAILMS
       li   r0,1
       b    *r13

* Change the border and sample 0 every 256 VRAM cells.  This is a safe March
* boundary: the current element has completed all operations for that cell.
VRMPOL mov  r11,@XWAIT
       mov  @VRPULS,r2
       andi r2,7
       sla  r2,1
       mov  @VRMCOL(r2),r0
       bl   @VDPREGW
       inc  @VRPULS
       bl   @POLL0
       jeq  VRMPRT
       li   r0,1
       mov  r0,@VRSTOP
VRMPRT mov  @XWAIT,r11
       rt

* VRBLK - local March-B over the 256-byte block starting at R8.
* Out: R0=0 on pass or R0=1 after recording the first failing
* address/expected/actual/mask in the shared failure cells.
VRBLK  mov  r11,r13
       mov  r8,r4
       li   r5,>0100
VRB0   mov  r4,r0
       clr  r1
       bl   @VRW1X
       inc  r4
       dec  r5
       jne  VRB0

       mov  r8,r4
       li   r5,>0100
VRB1   mov  r4,r0
       bl   @VRR1
       clr  r6
       cb   r6,r2
       jne  VRBBAD
       mov  r4,r0
       li   r1,>ff00
       bl   @VRW1X
       mov  r4,r0
       bl   @VRR1
       li   r6,>ff00
       cb   r6,r2
       jne  VRBBAD
       mov  r4,r0
       clr  r1
       bl   @VRW1X
       mov  r4,r0
       bl   @VRR1
       clr  r6
       cb   r6,r2
       jne  VRBBAD
       mov  r4,r0
       li   r1,>ff00
       bl   @VRW1X
       inc  r4
       dec  r5
       jne  VRB1

       mov  r8,r4
       li   r5,>0100
VRB2   mov  r4,r0
       bl   @VRR1
       li   r6,>ff00
       cb   r6,r2
       jne  VRBBAD
       mov  r4,r0
       clr  r1
       bl   @VRW1X
       mov  r4,r0
       li   r1,>ff00
       bl   @VRW1X
       inc  r4
       dec  r5
       jne  VRB2

       mov  r8,r4
       ai   r4,>00ff
       li   r5,>0100
VRB3   mov  r4,r0
       bl   @VRR1
       li   r6,>ff00
       cb   r6,r2
       jne  VRBBAD
       mov  r4,r0
       clr  r1
       bl   @VRW1X
       mov  r4,r0
       li   r1,>ff00
       bl   @VRW1X
       mov  r4,r0
       clr  r1
       bl   @VRW1X
       dec  r4
       dec  r5
       jne  VRB3

       mov  r8,r4
       ai   r4,>00ff
       li   r5,>0100
VRB4   mov  r4,r0
       bl   @VRR1
       clr  r6
       cb   r6,r2
       jne  VRBBAD
       mov  r4,r0
       li   r1,>ff00
       bl   @VRW1X
       mov  r4,r0
       clr  r1
       bl   @VRW1X
       dec  r4
       dec  r5
       jne  VRB4
       clr  r0
       b    *r13
VRBBAD mov  r4,@FAILAD
       mov  r6,@FAILXP
       mov  r2,@FAILAC
       xor  r2,r6
       mov  r6,@FAILMS
       li   r0,1
       b    *r13

* Low-level byte VRAM helpers used by March-B. Each VDP port access includes
* the conservative delay required by real hardware; do not remove the NOPs
* merely because an emulator tolerates back-to-back accesses.
VRFILL mov  r11,@XSAVE
       clr  r0
       bl   @XSETAW
       li   r2,>4000
VRFW   movb r1,@VDPWD
       nop
       dec  r2
       jne  VRFW
       mov  @XSAVE,r11
       rt
VRR1   mov  r11,@XSAVE
       bl   @XSETAR
       clr  r2
       movb @VDPRD,r2
       nop
       mov  @XSAVE,r11
       rt
VRW1X  mov  r11,@XSAVE
       bl   @XSETAW
       movb r1,@VDPWD
       nop
       mov  @XSAVE,r11
       rt
XSETAW mov  r0,r3
       swpb r3
       movb r3,@VDPWA
       nop
       mov  r0,r3
       andi r3,>3f00
       ori  r3,>4000
       movb r3,@VDPWA
       nop
       rt
XSETAR mov  r0,r3
       swpb r3
       movb r3,@VDPWA
       nop
       mov  r0,r3
       andi r3,>3f00
       movb r3,@VDPWA
       nop
       rt

* ---------------------------------------------------------------------------
* TMS9918-family visual diagnostics
* ---------------------------------------------------------------------------
* Visible VDP path check: printable-character matrix plus all 16 TMS9918A
* colors in foreground/background combinations.
VDPSHW li   r8,SVTXT
       bl   @SVCENT
       li   r0,>0003
       li   r1,DTITL
       bl   @PUTS
       li   r0,>0082
       li   r1,VDPAUTO
       bl   @PUTS
       li   r0,>00c2
       li   r1,VDPNEXT
       mov  @SYSID,r2
       ci   r2,ID994
       jne  VDNXOK
       li   r1,VDPN4
VDNXOK
       bl   @PUTS
       li   r0,>0142
       li   r1,VSTART
       bl   @PUTS
       bl   @WAITKY
       ci   r0,>3000
       jeq  VDPBACK
       li   r8,SVTXT
       bl   @SVCENT
       li   r0,>8081             * blank while rebuilding the Graphics-I page
       bl   @VDPREGW
       li   r0,>0380
       li   r8,SVAW
       bl   @SVCENT
       li   r1,COLTAB
       li   r2,32
VDCOL  movb *r1+,@VDPWD
       nop
       dec  r2
       jne  VDCOL
       clr  r0
       li   r8,SVAW
       bl   @SVCENT
       li   r1,>2000
       li   r2,>0300
VDCHAR movb r1,@VDPWD
       nop
       ai   r1,>0100
       ci   r1,>6000
       jl   VDKEEP
       li   r1,>2000
VDKEEP dec  r2
       jne  VDCHAR
       li   r0,>e081             * reveal only the completed page
       bl   @VDPREGW
       li   r5,120
       bl   @VDPHLD
       bl   @VDTEXT
       li   r5,120
       bl   @VDPHLD
       bl   @VDMULT
       li   r5,120
       bl   @VDPHLD
       mov  @SYSID,r0
       ci   r0,ID994             * original TMS9918 path omits Graphics II
       jeq  VDPNOB
       bl   @VDBMAP
       li   r5,120
       bl   @VDPHLD
VDPNOB
       bl   @VDSPRT
       bl   @WAIT0
VDPBACK
       b    @MENU

* ---------------------------------------------------------------------------
* VDP mode and sprite exercises
* ---------------------------------------------------------------------------
* Each mode is built with display disabled. Its final interrupt-enabled
* register-1 value is written only after all visible VRAM tables are coherent.
*
* 40-column Text mode.  PUTS converts its sample text to upper case when the
* verified 1979 TI-99/4 firmware set is active; /4A and QI retain lowercase.
* VDTEXT - 40-column text-mode page. This mode is skipped on a confirmed /4,
* whose original TMS9918 does not implement the /4A text/bitmap feature set.
VDTEXT mov  r11,@VDPRTN
       li   r8,SVTXT
       bl   @SVCENT
       li   r0,>8081             * hide intermediate Text-mode table writes
       bl   @VDPREGW
       clr  r0
       bl   @XSETAW
       li   r1,>2000
       li   r2,>03c0
VDTCLR movb r1,@VDPWD
       nop
       dec  r2
       jne  VDTCLR
       li   r0,>0056            * centered in the 40-column text row
       li   r1,VDTTX1
       bl   @PUTS
       li   r0,>00a0
       li   r1,VDTTX2
       bl   @PUTS
       li   r0,>00f0
       li   r1,VDTTX3
       bl   @PUTS
       li   r0,>f081             * text display with VBlank IRQ for page timing
       bl   @VDPREGW
       mov  @VDPRTN,r11
       rt

* Multicolor mode: generated 4x4 color-cell mosaic across the screen.
* VDMULT - multicolor mode pattern with all palette entries.
VDMULT mov  r11,@VDPRTN
       li   r8,SVTXT
       bl   @SVCENT
       li   r0,>8081             * hide intermediate Multicolor table writes
       bl   @VDPREGW
       clr  r0
       bl   @XSETAW
       li   r2,>0300
       clr  r6
VDMNM  movb r6,@VDPWD
       nop
       ai   r6,>0100
       dec  r2
       jne  VDMNM
       li   r0,>0800
       bl   @XSETAW
       li   r2,>0800
       li   r6,>2345
VDMPT  movb r6,@VDPWD
       nop
       ai   r6,>1100
       dec  r2
       jne  VDMPT
       li   r0,>e881             * multicolor display with VBlank IRQ enabled
       bl   @VDPREGW
       mov  @VDPRTN,r11
       rt

* Graphics II / bitmap mode.  Four unmistakably regular 8x8 tiles repeat
* across all three screen thirds; each scanline uses the next foreground
* color.  This still touches every bitmap pattern/color byte, but unlike the
* former rotating pseudo-random fill it cannot be mistaken for bad VRAM.
* VDBMAP - Graphics-II bitmap/table-layout validation. Never entered on /4.
VDBMAP mov  r11,@VDPRTN
       li   r8,SVTXT
       bl   @SVCENT
       li   r0,>8081             * hide partial bitmap tables and stale sprites
       bl   @VDPREGW
       li   r0,>3800
       bl   @XSETAW
       li   r2,>0300
       clr  r6
VDBNAM movb r6,@VDPWD
       nop
       ai   r6,>0100
       dec  r2
       jne  VDBNAM
       clr  r0
       bl   @XSETAW
       li   r2,>00c0            * 192 copies x 32 bytes = >1800
VDBPAT li   r1,VDBPDT
       li   r3,32
VDBPWR movb *r1+,@VDPWD
       nop
       dec  r3
       jne  VDBPWR
       dec  r2
       jne  VDBPAT
       li   r0,>2000
       bl   @XSETAW
       li   r2,>0300            * 768 characters x eight color bytes
VDBCCH li   r6,>1f00
       li   r3,8
VDBCOL movb r6,@VDPWD
       nop
       ai   r6,>1000
       dec  r3
       jne  VDBCOL
       dec  r2
       jne  VDBCCH
* Bitmap patterns occupy >0000..>17FF and therefore overwrite the ordinary
* >0300 sprite table.  Bitmap mode relocates that table to >3B00 (R5=>76), so
* terminate the relocated list explicitly instead of displaying stale VRAM.
       li   r0,>3b00
       bl   @XSETAW
       li   r1,>d000
       movb r1,@VDPWD
       nop
       li   r1,VDBREG
       li   r2,8
VDBRLP mov  *r1+,r0
       bl   @VDPREGW
       dec  r2
       jne  VDBRLP
       li   r0,>e081             * reveal the completed Graphics-II page
       bl   @VDPREGW
       mov  @VDPRTN,r11
       rt

* VDSPRT - Tutor-style moving pattern field and five-sprite VDP exercise.
*
* REPRODUCTION CONTRACT FOR VDP IMPLEMENTORS
*   The shared text initializer leaves the name table at >0000, sprite
*   attribute table at >0300 (R5=>06), and sprite pattern table at >1800
*   (R6=>03). This routine installs:
*
*     SAT entry   Y    initial X   pattern   color   purpose
*         0       79      40          0       15    collision member A
*         1       79      40          0        8    collision member B
*         2       79     160          0        5    independently visible
*         3       79     200          0        7    independently visible
*         4       79     240          0       10    fifth-sprite stimulus
*     terminator >D0
*
*   All entries occupy the same scanline. On a standard four-sprites-per-line
*   implementation, entries 0/1 overlap into one visible group, entries 2/3
*   form two more groups, and entry 4 is suppressed: three visible groups are
*   expected while the fifth-sprite flag is set. Only two visible groups on the
*   tested TI-99/4/Pico9918 combination is the open compatibility observation.
*
*   Every fresh VBlank updates X: entries 0/1 move together with PHASE; entry 2
*   uses 255-PHASE; entry 3 uses PHASE+64 modulo 256; entry 4 uses 191-PHASE
*   modulo 256. R1 is >E0 for 8x8, >E2 at frame 120 for 16x16, and >E3 at frame
*   240 for 16x16 magnified. The stage ends at frame 360.
*
*   VDPVB accumulates status bits >20 (collision) and >40 (fifth sprite) in the
*   high byte of VDPSTA. The result page reports observations, not independent
*   pass/fail claims. The /4 and /4A execute this same sprite routine; only the
*   earlier Graphics-II bitmap stage is skipped on a confirmed TI-99/4.
VDSPRT mov  r11,@VDPRTN
       li   r8,SVTXT
       bl   @SVCENT
       li   r0,>8081             * hide construction until sprites are valid
       bl   @VDPREGW
       clr  @VDPSTA
       li   r0,>0003
       li   r1,VDSTX
       bl   @PUTS
* Eight animated tile patterns at character codes 128..135.
       li   r0,>0c00
       bl   @XSETAW
       li   r1,DEMOPAT
       li   r2,64
VDSDPL movb *r1+,@VDPWD
       nop
       dec  r2
       jne  VDSDPL
* Fill rows 5..18 exactly as the accepted Tutor/Pyuuta showcase does while
* preserving both columns of the normal page frame.
       li   r0,>00a1
       li   r9,14
       li   r6,>8000
VDSFRW bl   @XSETAW
       li   r2,30
VDSFLD movb r6,@VDPWD
       nop
       ai   r6,>0100
       ci   r6,>8800
       jne  VDSFNC
       li   r6,>8000
VDSFNC dec  r2
       jne  VDSFLD
       ai   r0,32
       dec  r9
       jne  VDSFRW
* Keep the animated pattern field, but clear a six-row lane behind the sprite
* path so 8x8, 16x16, magnification, overlap, and motion remain unmistakable.
       li   r0,>0121             * rows 9..14, interior columns 1..30
       li   r9,6
       li   r1,>2000             * blank space character
VDSBRW bl   @XSETAW
       li   r2,30
VDSBLN movb r1,@VDPWD
       nop
       dec  r2
       jne  VDSBLN
       ai   r0,32
       dec  r9
       jne  VDSBRW
* Five same-scanline sprites; the first pair deliberately collide.
       li   r0,>1800
       bl   @XSETAW
       li   r1,SPRITE
       li   r2,32
VDSPLD movb *r1+,@VDPWD
       nop
       dec  r2
       jne  VDSPLD
       li   r0,>0300
       bl   @XSETAW
       li   r1,DEMOAT
       li   r2,21
VDSPLA movb *r1+,@VDPWD
       nop
       dec  r2
       jne  VDSPLA
       clr  @WFRAME
       clr  @WPHASE
       li   r0,>e081             * sprites require a real VBlank frame gate
       bl   @VDPREGW
VDSANM bl   @VDPVB
       inc  @WFRAME
       inc  @WPHASE
       mov  @WPHASE,r6
       andi r6,>00ff
* Rotate one tile pattern every frame so a stalled VDP is conspicuous.
       mov  @WFRAME,r7
       andi r7,7
       sla  r7,3
       ai   r7,DEMOFR
       li   r0,>0c00
       bl   @XSETAW
       li   r2,8
VDSDFR movb *r7+,@VDPWD
       nop
       dec  r2
       jne  VDSDFR
* Match the accepted Tutor/Pyuuta motion: the collision pair moves together,
* while the other three sprites cross it in opposing directions.
       mov  r6,r1
       swpb r1
       li   r0,>0301
       bl   @VRW1X
       mov  r6,r1
       swpb r1
       li   r0,>0305
       bl   @VRW1X
       li   r1,>00ff
       s    r6,r1
       swpb r1
       li   r0,>0309
       bl   @VRW1X
       mov  r6,r1
       ai   r1,64
       andi r1,>00ff
       swpb r1
       li   r0,>030d
       bl   @VRW1X
       li   r1,>00bf
       s    r6,r1
       andi r1,>00ff
       swpb r1
       li   r0,>0311
       bl   @VRW1X
       mov  @WFRAME,r4
       ci   r4,120
       jne  VDSS16
       li   r0,>e281
       bl   @VDPREGW
VDSS16 ci   r4,240
       jne  VDSKEY
       li   r0,>e381
       bl   @VDPREGW
VDSKEY bl   @POLL0
       jeq  VDSKGO
       b    @VDPBACK
VDSKGO
       mov  @WFRAME,r4
       ci   r4,360
       jl   VDSANM
* Match the Tutor v1.0 showcase with a silent three-second raster-wave finale.
* 0 remains live throughout and returns directly to the main menu.
       bl   @WAVINI
       li   r5,180
VDPSWV bl   @WAVFRM
       bl   @POLL0
       jeq  VDPSWN
       b    @VDPBACK
VDPSWN
       dec  r5
       jne  VDPSWV
       li   r8,SVTXT
       bl   @SVCENT
       li   r0,>0003
       li   r1,VDRTTL
       bl   @PUTS
       li   r0,>00a2
       li   r1,VDCOLL
       bl   @PUTS
       li   r0,>00b8
       li   r1,NOTSEE
       mov  @VDPSTA,r2
       andi r2,>2000
       jeq  VDSCNO
       li   r1,SEEN
VDSCNO bl   @PUTS
       li   r0,>00e2
       li   r1,VDFIFT
       bl   @PUTS
       li   r0,>00f8
       li   r1,NOTSEE
       mov  @VDPSTA,r2
       andi r2,>4000
       jeq  VDSFNO
       li   r1,SEEN
VDSFNO bl   @PUTS
       li   r0,>0162
       li   r1,VDPDONE
       bl   @PUTS
       li   r0,>02c2
       li   r1,ZEROMNU
       bl   @PUTS
       mov  @VDPRTN,r11
       rt

* VDPHLD - hold a visual page for VDPHCT VBlanks while keeping 0 responsive.
VDPHLD mov  r11,@XSAVE
       mov  r5,@VDPHCT          * input polling preserves the CPU registers
VDPHLP bl   @VDPVB
       bl   @POLL0
       jeq  VDPHGO
       b    @MENU               * every timed VDP page accepts 0 immediately
VDPHGO dec  @VDPHCT
       jne  VDPHLP
       mov  @XSAVE,r11
       rt

* Tutor v1.0 Wave + PSG page followed by the full MegaDemo demonstration.
* ---------------------------------------------------------------------------
* Sound, information pages, VRAM map, and LED guide
* ---------------------------------------------------------------------------

* PSGTST - introduce and run the integrated raster/music demonstration.
PSGTST li   r8,SVTXT
       bl   @SVCENT
       li   r0,>0006
       li   r1,STITL
       bl   @PUTS
       li   r0,>0062
       li   r1,SINFO1
       bl   @PUTS
       li   r0,>00a2
       li   r1,SINFO2
       bl   @PUTS
       li   r0,>0102
       li   r1,SSTART
       bl   @PUTS
       li   r0,>0142
       li   r1,SMUSIC
       bl   @PUTS
       bl   @WAVMUS
       li   r8,SVMUTE
       bl   @SVCENT
       b    @MENU

* Translate the most recent failing data mask into the physical 4116
* positions printed on the 4A motherboard schematic. More than one BAD is
* valid and means more than one data lane disagreed.
* VRAMID - map the last recorded TI-order XOR mask to the eight 4116 devices
* used on a TI-99/4A board. It is advisory and can identify multiple lanes.
VRAMID li   r8,SVTXT
       bl   @SVCENT
       li   r0,>0005
       li   r1,VITITL
       bl   @PUTS
       li   r0,>0062
       li   r1,VIMASK
       bl   @PUTS
       li   r0,>0072
       mov  @FAILMS,r1
       li   r8,SVHEX
       bl   @SVCENT
       li   r0,>00a2
       li   r1,VIHEAD
       bl   @PUTS
       li   r7,VILIST
       li   r0,>00e2
       li   r2,8
VILP   mov  r7,r1
       mov  r0,r6
       bl   @PUTS
       ai   r7,17               * 16 printable bytes plus terminator
       ai   r0,32
       dec  r2
       jne  VILP
       mov  @FAILMS,r4
       li   r3,>8000
       li   r0,>00f8
       li   r2,8
VIMARK czc  r3,r4
       jeq  VINEXT
       mov  r0,r6
       li   r1,VIBAD
       bl   @PUTS
       mov  r6,r0
VINEXT ai   r0,32
       srl  r3,1
       dec  r2
       jne  VIMARK
       mov  @FAILMS,r0
       jne  VINOTE
       li   r0,>0262
       li   r1,VINONE
       bl   @PUTS
VINOTE li   r0,>02a2
       li   r1,VICAUT
       bl   @PUTS
       li   r0,>02c2
       li   r1,ZEROMNU
       bl   @PUTS
       bl   @WAIT0
       b    @MENU

* CREDITS - static project provenance page.
CREDITS
       li   r8,SVTXT
       bl   @SVCENT
       li   r0,>000c
       li   r1,CRTITL
       bl   @PUTS
       li   r0,>0062
       li   r1,CR1
       bl   @PUTS
       li   r0,>00a2
       li   r1,CR2
       bl   @PUTS
       li   r0,>00e2
       li   r1,CR3
       bl   @PUTS
       li   r0,>0122
       li   r1,CR4
       bl   @PUTS
       li   r0,>0162
       li   r1,CR5
       bl   @PUTS
       li   r0,>01a2
       li   r1,CR6
       bl   @PUTS
       li   r0,>0222
       li   r1,CR7
       bl   @PUTS
       li   r0,>02a2
       li   r1,ZEROMNU
       bl   @PUTS
       bl   @WAIT0
       b    @MENU

* LEDTST - automatic patterns followed by operator-stepped individual lamps.
* Exiting restores the final automatic-result LED mask.
LEDTST li   r8,SVTXT
       bl   @SVCENT
       li   r0,>0005
       li   r1,LTITL
       bl   @PUTS
       li   r0,>0082
       li   r1,LINFO1
       bl   @PUTS
       li   r0,>00c2
       li   r1,LINFO2
       bl   @PUTS
       li   r0,>0102
       li   r1,LINFO3
       bl   @PUTS
       li   r0,>0182
       li   r1,LSTART
       bl   @PUTS
       li   r0,>01c2
       li   r1,LSTOP
       bl   @PUTS
* The core service plays the compact automatic walk, Larson, fill/drain, and
* group-flash sequence.  The interactive walk below then isolates each lamp.
       li   r8,SVLEDS
       bl   @SVCENT
       li   r0,6
       mov  r0,@XDATA
LEDKEY bl   @WAITKY
       ci   r0,>3000
       jeq  LEDXIT
       li   r1,6
       s    @XDATA,r1
       sla  r1,1
       mov  @XLEDTB(r1),r15
       movb r15,@LEDOUT
       li   r0,>01d8
       mov  r15,r1
       li   r8,SVHEX
       bl   @SVCENT
       dec  @XDATA
       jne  LEDKEY
       li   r0,6                 * keep the sixth lamp visible; next key wraps
       mov  r0,@XDATA
       jmp  LEDKEY
LEDXIT mov  @LEDSTA,r15
       movb r15,@LEDOUT
       b    @MENU

* Re-enter the fixed automatic core without resetting the console. This is a
* warm start, not a promise to automate the interactive observation screens.
RERUN  li   r8,SVRUN
       b    @SVCENT             * MAIN never returns

* ---------------------------------------------------------------------------
* Original MegaDemo bank-18 raster wave plus the exact 298-byte music phrase
* from the released Pyuuta/Tutor v1.0 diagnostic. The frame-delay records and
* eight repeats are intentionally identical; 0 aborts and mutes immediately.
* ---------------------------------------------------------------------------

* WAVMUS - play eight exact repetitions of MDPSG while calling WAVFRM once
* for every elapsed video frame. The encoded PSG bytes are never retuned.
WAVMUS mov  r11,@WAVRTN
       bl   @XMUTE
       bl   @WAVINI
       li   r7,8
MUSREP li   r5,MDPSG
MUSNXT clr  r8
       movb *r5+,r8             * video-frame delay before the next PSG event
       jeq  MUSRPT              * zero terminates the 224-frame phrase
       srl  r8,8
MUSDLY bl   @WAVFRM
       bl   @POLL0
       jne  MUSEND
       dec  r8
       jne  MUSDLY
       clr  r6
       movb *r5+,r6             * raw SN76489 byte count
       srl  r6,8
MUSWRT movb *r5+,@SNDOUT
       dec  r6
       jne  MUSWRT
       jmp  MUSNXT
MUSRPT dec  r7
       jne  MUSREP
MUSEND bl   @XMUTE
       mov  @WAVRTN,r11
       rt

XMUTE  li   r1,>9f00
       movb r1,@SNDOUT
       li   r1,>bf00
       movb r1,@SNDOUT
       li   r1,>df00
       movb r1,@SNDOUT
       li   r1,>ff00
       movb r1,@SNDOUT
       rt

* POLL0 - nonblocking direct-matrix check for 0.
* Out: R0=1 if pressed, R0=0 otherwise; restores R8 and the caller's R11.
POLL0  mov  r11,@POLSAV
       mov  r8,@POLR8           * SVCENT uses R8 as its service selector
       li   r8,SVKEY
       bl   @SVCENT
       clr  r0
       movb @>8375,r0
       ci   r0,>3000
       jne  POLLNO
       li   r0,1
       jmp  POLLRT
POLLNO clr  r0
POLLRT mov  @POLR8,r8
       mov  @POLSAV,r11
       mov  r0,r0               * return zero/nonzero condition to every caller
       rt

* VDPVB - wait for one fresh VBlank and collect collision/fifth-sprite flags.
* The real path gates on TMS9901 INT2 before acknowledging VDP status. Reading
* status first would consume the edge and previously caused the raster effect
* to run at turbo speed on timing-sensitive implementations.
VDPVB  mov  r11,@VBSAV
* This is the original MegaDemo controller's VBlank gate verbatim in behavior:
* test TMS9901 input 2 until it is asserted, then acknowledge that one edge by
* reading VDP status.  Do not pre-read status here. On some implementations the
* interrupt input remains latched for a few CPU cycles after a
* status read; pre-reading immediately before TB 2 therefore accepted the same
* edge repeatedly and made the 1,024-frame effect finish in "turbo" time.
       clr  r12
VDPVBL tb   2
       jeq  VDPVBL
       clr  r0
       movb @VDPST,r0
       mov  r0,r1
       andi r1,>6000
       soc  r1,@VDPSTA
VDPVBR
       mov  @VBSAV,r11
       rt

* VDPREGW - write register/value word R0 and maintain the shared R1 shadow.
VDPREGW
       mov  r0,@VDPTMP
       andi r0,>00ff
       ci   r0,>0081
       jne  VDPWNS
       movb @VDPTMP,@VDP1SH
VDPWNS mov  @VDPTMP,r0
       movb r0,@VDPWA
       nop
       swpb r0
       movb r0,@VDPWA
       nop
       rt

* ---------------------------------------------------------------------------
* Original MegaDemo raster controller and Tutor/Pyuuta PSG phrase
* ---------------------------------------------------------------------------
* The relocated original controller runs exactly once per fresh VBlank.
* WAVINI - copy and initialize the relocated bank-18 effect in U7 SRAM.
* The original routine temporarily owns workspace >8300; this adapter restores
* the diagnostic workspace and return link before returning.
WAVINI mov  r11,@WAFRTN
       clr  @WFRAME
       clr  @WPHASE
       clr  @WFXDONE

* Copy the complete relocated bank-18 payload into the upper half of the
* tester's U7 SRAM.  The first two words are its TOPINI/TOPFRM vectors.  U7 is
* always present on the sidecar, unlike the console's optional >A000 RAM.
       li   r0,MDFXWK
       li   r1,MDFXRM
       li   r2,MDFXLN
WAVXCP mov  *r1+,*r0+
       dect r2
       jne  WAVXCP

* Run the original initializer in its original >8300 workspace.  Its music
* callbacks point at the local RT stub because WAVMUS owns sound scheduling.
       lwpi >8300
       mov  @MDFXWK,r1
       bl   *r1
       lwpi >c000
       mov  @WAFRTN,r11
       rt

* WAVFRM - execute exactly one original raster-controller frame after a fresh
* VBlank. Out: R0 mirrors the original completion indication.
WAVFRM
* The original controller enters TOPFRM exactly once per asserted VDP
* interrupt.  The collision waits inside TOPFRM divide that one display
* frame into raster bands; they are not a substitute for the leading
* vertical-blank edge.  Entering the routine from an unpaced foreground
* loop makes a stale/early collision collapse the animation into "turbo".
* Start TOPFRM from a fresh VDP interrupt just as the original MegaDemo
* controller does.  A software delay cannot provide this alignment: it slows
* the PSG stream while letting the collision-timed raster splits begin at an
* arbitrary scanline, which appears as fast tearing even though the music is
* slow. The active-low TMS9901 interrupt input is therefore the timing source.
* Preserve WAVFRM's caller before BL changes R11.  Saving R11 after VDPVB would
* capture the address inside WAVFRM; the final RT would then re-enter here after
* the frame gate and run WXRUN continuously, starving the PSG stream and making
* the raster animation appear about four times too fast.
       mov  r11,@WAFRTN
       bl   @VDPVB
       lwpi >8300
       mov  @MDFXWK+2,r1
       bl   *r1
       mov  r0,@WFXDONE
       lwpi >c000
       mov  @WAFRTN,r11
       mov  @WFXDONE,r0
       rt

* ---------------------------------------------------------------------------
* Shared UI/input adapters and immutable extension tables
* ---------------------------------------------------------------------------

* Put a zero-terminated string through the fixed-core ABI.
PUTS   li   r8,SVPUT
       b    @SVCENT

* Main-menu press returns immediately so the bold glyph and key beep occur
* while the operator is still pressing the number, matching Tutor v1.0.
MENUPR mov  r11,@XWAIT
MPRREL li   r8,SVKEY
       bl   @SVCENT
       clr  r0
       movb @>8375,r0
       ci   r0,>ff00
       jne  MPRREL
MPRPRS li   r8,SVKEY
       bl   @SVCENT
       clr  r0
       movb @>8375,r0
       ci   r0,>ff00
       jeq  MPRPRS
       mov  @XWAIT,r11
       rt

MENUACK mov  r11,r10
       bl   @VRW1X
       li   r0,>8800
       movb r0,@SNDOUT
       li   r0,>0800
       movb r0,@SNDOUT
       li   r0,>9200
       movb r0,@SNDOUT
       li   r5,4
MACKLP bl   @VDPVB
       dec  r5
       jne  MACKLP
       bl   @XMUTE
       b    *r10

* Return the released ASCII/control key in the high byte of R0.  Waiting for
* release before and after each press provides deterministic menu debounce.
WAITKY mov  r11,@XWAIT
WKREL  li   r8,SVKEY
       bl   @SVCENT
       clr  r0
       movb @>8375,r0
       ci   r0,>ff00
       jne  WKREL
WKPRS  li   r8,SVKEY
       bl   @SVCENT
       clr  r0
       movb @>8375,r0
       ci   r0,>ff00
       jeq  WKPRS
       mov  r0,r9
WKUP   li   r8,SVKEY
       bl   @SVCENT
       clr  r0
       movb @>8375,r0
       ci   r0,>ff00
       jne  WKUP
       mov  r9,r0
       mov  @XWAIT,r11
       rt

* Wait specifically for 0.  Result/help pages no longer disappear on an
* accidental key and every such page advertises the same route to the menu.
WAIT0  mov  r11,@XDRAW
W0LOOP bl   @WAITKY
       ci   r0,>3000
       jne  W0LOOP
       mov  @XDRAW,r11
       rt

COLTAB byte >f1,>e2,>d3,>c4,>b5,>a6,>97,>86
       byte >75,>64,>53,>42,>31,>2f,>4f,>8f
