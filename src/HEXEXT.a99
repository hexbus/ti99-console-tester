* Fixed-core ABI 1.1 assets.  Unknown/no-GROM systems conservatively use the
* /4A table because that is the useful recovery wiring for the common 48-key
* console.  A complete known 1979 firmware set selects the separate /4 table.
       aorg >7f00
KMTAB  byte >3d,>80,>81,>85,>82,>83,>84,>86
       byte >2e,>4c,>4f,>39,>32,>53,>57,>58
       byte >2c,>4b,>49,>38,>33,>44,>45,>43
       byte >4d,>4a,>55,>37,>34,>46,>52,>56
       byte >4e,>48,>59,>36,>35,>47,>54,>42
       byte >2f,>3b,>50,>30,>31,>41,>51,>5a

* The 1979 console has a five-column, 40-key matrix
* that is physically different from the /4A and QI 6x8 matrix.  The direct
* scanner selects this table only after the full stock /4 ROM/GROM set has
* identified the machine.  Unknown/no-GROM systems conservatively use /4A
* wiring, which is the useful recovery case for the common 48-key console.
       aorg >7f30
K4TAB  byte >81,>4c,>50,>30,>83,>80,>51,>31
       byte >2c,>4b,>4f,>39,>5a,>41,>57,>32
       byte >4d,>4a,>49,>38,>58,>53,>45,>33
       byte >4e,>48,>55,>37,>43,>44,>52,>34
       byte >42,>47,>59,>36,>56,>46,>54,>35

* Positional SHIFT translations from the original 40-key legends and TI's
* function-key addendum. Function letters remain alphabetic because KMAT names
* the physical chord; the UI never dispatches QUIT/REDO/etc. as actions.
K4SHT  byte >0d,>3d,>22,>29,>ff,>20,>51,>21
       byte >2e,>2f,>2b,>28,>5a,>41,>57,>40
       byte >3b,>5e,>2d,>2a,>58,>53,>45,>23
       byte >3a,>3c,>5f,>26,>43,>44,>52,>24
       byte >3f,>47,>3e,>27,>56,>46,>54,>25

* Shift translation for ASCII >20..>5F.  Letters remain uppercase here;
* matrix-chord rendering separately exposes the physical modifier combination.
       aorg >7f80
KSHTAB byte >20,>21,>22,>23,>24,>25,>26,>27
       byte >28,>29,>2a,>2b,>3c,>2d,>3e,>2d
       byte >29,>21,>40,>23,>24,>25,>5e,>26
       byte >2a,>28,>3a,>3a,>3c,>2b,>3e,>3f
       byte >40,>41,>42,>43,>44,>45,>46,>47
       byte >48,>49,>4a,>4b,>4c,>4d,>4e,>4f
       byte >50,>51,>52,>53,>54,>55,>56,>57
       byte >58,>59,>5a,>5b,>5c,>5d,>5e,>5f

       aorg >7ffe
       data >0000                * build-time checksum correction
       end
